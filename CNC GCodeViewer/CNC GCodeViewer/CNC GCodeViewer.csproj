<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>CNC.Controls.Viewer</RootNamespace>
    <AssemblyName>CNC.Controls.Viewer</AssemblyName>
    <UICulture>en-US</UICulture>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <DefineConstants>TRACE;DEBUG</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <!-- Package references -->
  <ItemGroup>
    <!-- Note: HelixToolkit.Wpf will need to be replaced with a cross-platform 3D library for full cross-platform support -->
  </ItemGroup>

  <!-- Project references -->
  <ItemGroup>
    <ProjectReference Include="..\..\CNC Controls\CNC Controls\CNC Controls.csproj" />
    <ProjectReference Include="..\..\CNC Core\CNC Core\CNC Core.csproj" />
  </ItemGroup>

  <!-- Remove the default Compile items to avoid duplicates -->
  <ItemGroup>
    <Compile Remove="**/*.cs" />
    <Page Remove="**/*.xaml" />
    <Resource Remove="**/*" />
  </ItemGroup>

  <!-- For cross-platform build, include basic viewer components without WPF UI -->
  <ItemGroup>
    <Compile Include="Properties\AssemblyInfo.cs" />
    <!-- Note: UI components temporarily excluded for cross-platform compatibility -->
    <!-- Full 3D viewer functionality will require cross-platform UI framework -->
  </ItemGroup>

</Project>