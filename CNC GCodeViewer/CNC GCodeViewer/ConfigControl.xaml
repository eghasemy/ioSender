<UserControl
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="using:CNC.Controls.Viewer"
             xmlns:Controls="using:CNC.Controls;assembly=CNC.Controls.WPF" x:Class="CNC.Controls.Viewer.ConfigControl"
             mc:Ignorable="d"
             d:DesignHeight="370" d:DesignWidth="310">
    <HeaderedContentControl x:Name="grpGCodeViewer" Header="GCode Viewer" HorizontalAlignment="Left" VerticalAlignment="Top" Height="Auto" Width="310">
        <StackPanel HorizontalAlignment="Left" Height="Auto" Margin="0,3,0,0" VerticalAlignment="Top">
            <CheckBox Content="Enable" Margin="160,2,0,0" IsChecked="{Binding Path=GCodeViewer.IsEnabled, Mode=TwoWay}"/>
            <Controls:NumericField Label="Arc resolution:" Unit="segments" Format="#0" ColonAt="160" Value="{Binding Path=GCodeViewer.ArcResolution, Mode=TwoWay}" IsEnabled="{Binding Path=GCodeViewer.IsEnabled, Mode=OneWay}"/>
            <Controls:NumericField Label="Min distance:" ColonAt="160" Value="{Binding Path=GCodeViewer.MinDistance, Mode=TwoWay}" IsEnabled="{Binding Path=GCodeViewer.IsEnabled, Mode=OneWay}"/>
            <Controls:NumericField Label="Tool diameter:" Unit="mm" Format="###0.0" ColonAt="160" Value="{Binding Path=GCodeViewer.ToolDiameter, Mode=TwoWay}" IsEnabled="{Binding Path=GCodeViewer.IsEnabled, Mode=OneWay}" ToolTip.Tip="Default tool diameter." />

            <StackPanel Orientation="Horizontal" Height="Auto">
                <Label Content="Cut color:" Width="160" HorizontalContentAlignment="Right"/>
                <local:ColorPicker x:Name="_colorPicker" SelectedColor="{Binding Path=GCodeViewer.CutMotionColor, Mode=TwoWay}" IsEnabled="{Binding Path=GCodeViewer.IsEnabled, Mode=OneWay}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Height="Auto">
                <Label Content="Rapids color:" Width="160" HorizontalContentAlignment="Right"/>
                <local:ColorPicker x:Name="_colorPicker1" SelectedColor="{Binding Path=GCodeViewer.RapidMotionColor, Mode=TwoWay}" IsEnabled="{Binding Path=GCodeViewer.IsEnabled, Mode=OneWay}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Height="Auto">
                <Label Content="Retract color:" Width="160" HorizontalContentAlignment="Right"/>
                <local:ColorPicker x:Name="_colorPicker2" SelectedColor="{Binding Path=GCodeViewer.RetractMotionColor, Mode=TwoWay}" IsEnabled="{Binding Path=GCodeViewer.IsEnabled, Mode=OneWay}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Height="Auto">
                <Label Content="Highlight color:" Width="160" HorizontalContentAlignment="Right"/>
                <local:ColorPicker x:Name="_colorPicker4" SelectedColor="{Binding Path=GCodeViewer.HighlightColor, Mode=TwoWay}" IsEnabled="{Binding Path=GCodeViewer.IsEnabled, Mode=OneWay}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Height="Auto">
                <Label Content="Grid color:" Width="160" HorizontalContentAlignment="Right"/>
                <local:ColorPicker x:Name="_colorPicker3" SelectedColor="{Binding Path=GCodeViewer.GridColor, Mode=TwoWay}" IsEnabled="{Binding Path=GCodeViewer.IsEnabled, Mode=OneWay}" VerticalAlignment="Center"/>
            </StackPanel>
            <CheckBox Content="Black background" Margin="5,2,0,0" IsChecked="{Binding Path=GCodeViewer.BlackBackground, Mode=TwoWay}" IsEnabled="{Binding Path=GCodeViewer.IsEnabled, Mode=OneWay}"/>
            <CheckBox Content="Show grid" Margin="5,2,0,0" IsChecked="{Binding Path=GCodeViewer.ShowGrid, Mode=TwoWay}" IsEnabled="{Binding Path=GCodeViewer.IsEnabled, Mode=OneWay}"/>
            <CheckBox Content="Show axes" Margin="5,2,0,0" IsChecked="{Binding Path=GCodeViewer.ShowAxes, Mode=TwoWay}" IsEnabled="{Binding Path=GCodeViewer.IsEnabled, Mode=OneWay}"/>
            <CheckBox  Content="Show work envelope" Margin="5,2,0,0" IsChecked="{Binding Path=GCodeViewer.ShowWorkEnvelope, Mode=TwoWay}" IsEnabled="{Binding Path=GCodeViewer.IsHomingEnabled, Mode=OneWay}"/>
            <CheckBox Content="Show bounding box" Margin="5,2,0,0" IsChecked="{Binding Path=GCodeViewer.ShowBoundingBox, Mode=TwoWay}" IsEnabled="{Binding Path=GCodeViewer.IsEnabled, Mode=OneWay}"/>
            <CheckBox Content="Show ViewCube" Margin="5,2,0,0" IsChecked="{Binding Path=GCodeViewer.ShowViewCube, Mode=TwoWay}" IsEnabled="{Binding Path=GCodeViewer.IsEnabled, Mode=OneWay}"/>
            <CheckBox Content="Show coordinate system" Margin="5,2,0,0" IsChecked="{Binding Path=GCodeViewer.ShowCoordinateSystem, Mode=TwoWay}" IsEnabled="{Binding Path=GCodeViewer.IsEnabled, Mode=OneWay}"/>
            <CheckBox Content="Show text overlay" Margin="5,2,0,0" IsChecked="{Binding Path=GCodeViewer.ShowTextOverlay, Mode=TwoWay}" IsEnabled="{Binding Path=GCodeViewer.IsEnabled, Mode=OneWay}"/>
            <CheckBox Content="Auto scale tool" Margin="5,2,0,0" IsChecked="{Binding Path=GCodeViewer.ToolAutoScale, Mode=TwoWay}" IsEnabled="{Binding Path=GCodeViewer.IsEnabled, Mode=OneWay}"/>
            <CheckBox Content="Highlight completed cuts" Margin="5,2,0,0" IsChecked="false" IsEnabled="False"/>
            <!--
            <CheckBox Content="Highlight completed cuts" Margin="5,2,0,0" IsChecked="{Binding Path=GCodeViewer.RenderExecuted, Mode=TwoWay}" IsEnabled="{Binding Path=GCodeViewer.IsEnabled, Mode=OneWay}"/>
            -->
        </StackPanel>
    </HeaderedContentControl>
</UserControl>
