    <system:String x:Key="NoProbe">Probing failed, probe is not connected.</system:String>
    <system:String x:Key="ProbeAsserted">Probing failed, probe signal is asserted.</system:String>
    <system:String x:Key="FailedNotIdle">Probing failed, Grbl is not in idle or tool changing state.</system:String>
