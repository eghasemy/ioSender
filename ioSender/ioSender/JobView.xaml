<UserControl x:Class="GCode_Sender.JobView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             xmlns:local="using:GCode_Sender"
             xmlns:cnccontrols="using:CNC.Controls"
             xmlns:cncviewer="using:CNC.Controls.Viewer"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="875">
    <UserControl.Resources>
        <system:String x:Key="MsgWaiting">Waiting for controller ({0})...</system:String>
        <system:String x:Key="MsgNoCommAlarm">Controller is not able to communicate due to alarm {0}, attempting a soft reset.</system:String>
        <system:String x:Key="MsgResetFailed">Controller soft reset failed, exiting.</system:String>
        <system:String x:Key="MsgEStop">E-Stop active! - clear before continuing...</system:String>
        <system:String x:Key="MsgEStopExit">E-Stop still active, exit?</system:String>
        <system:String x:Key="MsgHome">Homing cycle required, &lt;Home&gt; to continue</system:String>
        <system:String x:Key="MsgDoorOpen">Door is open, close door and continue?</system:String>
        <system:String x:Key="MsgDoorExit">Door is still open, exit?</system:String>
        <system:String x:Key="MsgDoorPersist">Door state cannot be cleared with &lt;Reset&gt;</system:String>
        <system:String x:Key="MsgNoComm">Controller is in {0} state and cannot respond, try a soft reset?</system:String>
        <system:String x:Key="MsgResetExit">Controller soft reset failed, exiting.</system:String>
        <system:String x:Key="MsgNoResponse">Controller is not responding!</system:String>
    </UserControl.Resources>
    <DockPanel VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
            <!-- MDI Control placeholder -->
            <TextBox x:Name="mdiControl" Watermark="MDI Command" HorizontalAlignment="Left" VerticalAlignment="Center" Width="200"/>
            <TextBlock Text="{Binding Path=ParserState}" TextWrapping="NoWrap" Margin="5,0,0,2" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="23"/>
        </StackPanel>
        <DockPanel x:Name="dp" DockPanel.Dock="Left" Margin="5,5,5,0" Width="220" HorizontalAlignment="Left" VerticalAlignment="Stretch">
            <StackPanel x:Name="t1" Height="Auto" HorizontalAlignment="Left" VerticalAlignment="Top" DockPanel.Dock="Top">
                <!-- DRO Control placeholder -->
                <Border BorderBrush="Gray" BorderThickness="1" Padding="5" Margin="0,0,0,5">
                    <StackPanel>
                        <TextBlock Text="DRO Control" FontWeight="Bold"/>
                        <TextBlock Text="Position display goes here"/>
                    </StackPanel>
                </Border>
                <!-- Limits Control placeholder -->
                <Border BorderBrush="Gray" BorderThickness="1" Padding="5" IsVisible="False">
                    <TextBlock Text="Limits Control"/>
                </Border>
            </StackPanel>
            <StackPanel x:Name="t2" Height="Auto" HorizontalAlignment="Left" VerticalAlignment="Bottom" DockPanel.Dock="Bottom">
                <!-- Signals Control placeholder -->
                <Border BorderBrush="Gray" BorderThickness="1" Padding="5" Margin="0,0,0,5">
                    <StackPanel>
                        <TextBlock Text="Signals Control" FontWeight="Bold"/>
                        <TextBlock Text="Status signals here"/>
                    </StackPanel>
                </Border>
                <!-- Status Control placeholder -->
                <Border BorderBrush="Gray" BorderThickness="1" Padding="5" Margin="0,5,0,0">
                    <TextBlock Text="Status Control"/>
                </Border>
            </StackPanel>
        </DockPanel>
        <StackPanel DockPanel.Dock="Right" Margin="5,5,5,0" Width="250" VerticalAlignment="Stretch">
            <!-- Work Parameters Control placeholder -->
            <Border BorderBrush="Gray" BorderThickness="1" Padding="5" Margin="0,0,0,5">
                <TextBlock Text="Work Parameters Control"/>
            </Border>
            <!-- Coolant Control placeholder -->
            <Border BorderBrush="Gray" BorderThickness="1" Padding="5" Margin="0,0,0,5">
                <TextBlock Text="Coolant Control"/>
            </Border>
            <!-- Spindle Control placeholder -->
            <Border BorderBrush="Gray" BorderThickness="1" Padding="5" Margin="0,0,0,5">
                <TextBlock Text="Spindle Control"/>
            </Border>
            <!-- Feed Control placeholder -->
            <Border BorderBrush="Gray" BorderThickness="1" Padding="5">
                <TextBlock Text="Feed Control"/>
            </Border>
        </StackPanel>
        <DockPanel HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,5,0,0">
            <!-- Job Control placeholder -->
            <Border BorderBrush="Gray" BorderThickness="1" Padding="5" Margin="0,5,0,0" DockPanel.Dock="Bottom" Height="100">
                <TextBlock Text="Job Control"/>
            </Border>
            <TabControl x:Name="tabGCode" TabStripPlacement="Bottom" DockPanel.Dock="Top">
                <TabItem Header="Program">
                    <!-- GCode List Control placeholder -->
                    <Border BorderBrush="Gray" BorderThickness="1" Padding="5">
                        <TextBlock Text="GCode List Control - Program view"/>
                    </Border>
                </TabItem>
                <TabItem x:Name="tab3D" Header="3D View">
                    <!-- 3D Renderer placeholder -->
                    <Border BorderBrush="Gray" BorderThickness="1" Padding="5">
                        <TextBlock Text="3D View - GCode Renderer"/>
                    </Border>
                </TabItem>
                <TabItem x:Name="tabConsole" Header="Console">
                    <!-- Console Control placeholder -->
                    <Border BorderBrush="Gray" BorderThickness="1" Padding="5">
                        <TextBlock Text="Console Control"/>
                    </Border>
                </TabItem>
            </TabControl>
        </DockPanel>
    </DockPanel>
</UserControl>
