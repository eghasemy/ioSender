<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="using:System;assembly=System.Runtime"
                    xmlns:local="using:CNC.Controls">
    <system:String x:Key="x:Key="CreateConfig"">Config file not found or invalid, create new?</system:String>
