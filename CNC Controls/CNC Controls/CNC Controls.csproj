<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>CNC.Controls</RootNamespace>
    <AssemblyName>CNC.Controls.WPF</AssemblyName>
    <UICulture>en-US</UICulture>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <DefineConstants>TRACE;DEBUG;USEWEBSOCKET</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DefineConstants>TRACE;USEWEBSOCKET</DefineConstants>
  </PropertyGroup>
  <!-- Package references for all targets -->
  <ItemGroup>
    <PackageReference Include="System.Data.DataSetExtensions" Version="4.5.0" />
  </ItemGroup>

  <!-- Project references -->
  <ItemGroup>
    <ProjectReference Include="..\..\CNC Core\CNC Core\CNC Core.csproj" />
  </ItemGroup>

  <!-- Remove the default Compile items to avoid duplicates -->
  <ItemGroup>
    <Compile Remove="**/*.cs" />
    <Page Remove="**/*.xaml" />
    <Resource Remove="**/*" />
  </ItemGroup>

  <!-- For cross-platform build, only include core interfaces -->
  <ItemGroup>
    <Compile Include="IGCodeConverter.cs" />
    <Compile Include="IGCodeTransformer.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>

</Project>