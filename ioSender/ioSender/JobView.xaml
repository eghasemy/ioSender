<UserControl x:Class="GCode_Sender.JobView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:GCode_Sender"
             xmlns:cnccontrols="clr-namespace:CNC.Controls;assembly=CNC.Controls.WPF"
             xmlns:cncviewer="clr-namespace:CNC.Controls.Viewer;assembly=CNC.Controls.Viewer"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="875"
             Focusable="True"
             Loaded="JobView_Load"
             IsVisibleChanged="JobView_IsVisibleChanged"
             FocusVisualStyle="{x:Null}"
             SizeChanged="JobView_SizeChanged">
    <UserControl.Resources>
        <system:String x:Uid="str_msgWait" x:Key="MsgWaiting">Waiting for controller ({0})...</system:String>
        <system:String x:Uid="str_msgNoCommAlarm" x:Key="MsgNoCommAlarm">Controller is not able to communicate due to alarm {0}, attempting a soft reset.</system:String>
        <system:String x:Uid="str_msgResetFailed" x:Key="MsgResetFailed">Controller soft reset failed, exiting.</system:String>
        <system:String x:Uid="str_msgEStop" x:Key="MsgEStop">E-Stop active! - clear before continuing...</system:String>
        <system:String x:Uid="str_msgEStopExit" x:Key="MsgEStopExit">E-Stop still active, exit?</system:String>
        <system:String x:Uid="str_msgHome" x:Key="MsgHome">Homing cycle required, &lt;Home&gt; to continue</system:String>
        <system:String x:Uid="str_msgDoorOpen" x:Key="MsgDoorOpen">Door is open, close door and continue?</system:String>
        <system:String x:Uid="str_msgDoorExit" x:Key="MsgDoorExit">Door is still open, exit?</system:String>
        <system:String x:Uid="str_msgDoorPersist" x:Key="MsgDoorPersist">Door state cannot be cleared with &lt;Reset&gt;</system:String>
        <system:String x:Uid="str_msgNoComm" x:Key="MsgNoComm">Controller is in {0} state and cannot respond, try a soft reset?</system:String>
        <system:String x:Uid="str_msgResetExit" x:Key="MsgResetExit">Controller soft reset failed, exiting.</system:String>
        <system:String x:Uid="str_msgNoResponse" x:Key="MsgNoResponse">Controller is not responding!</system:String>
        <cnccontrols:BoolToVisibleConverter x:Key="IsVisibleConverter" />
    </UserControl.Resources>
    
    <!-- Touch-Friendly Grid Layout -->
    <Grid MouseDown="outside_MouseDown" Background="{StaticResource HeroUI.Background}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Main Content Area -->
        <Grid Grid.Row="0" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>
            
            <!-- Left Panel - DRO and Controls -->
            <StackPanel Grid.Column="0">
                <!-- DRO Card -->
                <Border Style="{StaticResource HeroUI.Card}">
                    <StackPanel>
                        <TextBlock Text="Digital Readout" 
                                  FontSize="16" 
                                  FontWeight="SemiBold" 
                                  Foreground="{StaticResource HeroUI.Text.Primary}" 
                                  Margin="0,0,0,16"/>
                        <cnccontrols:DROControl x:Name="DRO" HorizontalAlignment="Stretch" VerticalAlignment="Top"/>
                        <cnccontrols:LimitsControl x:Name="limitsControl" 
                                                  HorizontalAlignment="Stretch" 
                                                  VerticalAlignment="Top" 
                                                  Visibility="Collapsed"
                                                  Margin="0,16,0,0"/>
                    </StackPanel>
                </Border>
                
                <!-- Status and Signals Card -->
                <Border Style="{StaticResource HeroUI.Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Machine Status" 
                                  FontSize="16" 
                                  FontWeight="SemiBold" 
                                  Foreground="{StaticResource HeroUI.Text.Primary}" 
                                  Margin="0,0,0,16"/>
                        <cnccontrols:SignalsControl x:Name="signalsControl" HorizontalAlignment="Stretch" VerticalAlignment="Top"/>
                        <cnccontrols:StatusControl x:Name="statusControl" 
                                                  Margin="0,16,0,0" 
                                                  HorizontalAlignment="Stretch" 
                                                  VerticalAlignment="Top"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            
            <!-- Center Panel - Main Content -->
            <Border Grid.Column="1" Style="{StaticResource HeroUI.Card}" Margin="16,0">
                <DockPanel>
                    <!-- Job Control at Bottom -->
                    <Border DockPanel.Dock="Bottom" 
                           Background="{StaticResource HeroUI.Surface}" 
                           BorderBrush="{StaticResource HeroUI.Border}"
                           BorderThickness="0,1,0,0"
                           Padding="0,16,0,0"
                           Margin="0,16,0,0">
                        <cnccontrols:JobControl x:Name="GCodeSender"/>
                    </Border>
                    
                    <!-- Tabbed Content -->
                    <TabControl x:Name="tabGCode" TabStripPlacement="Bottom" DockPanel.Dock="Top">
                        <TabControl.Resources>
                            <Style TargetType="{x:Type TabItem}" BasedOn="{StaticResource HeroUI.TabItem}">
                                <Setter Property="MinWidth" Value="100"/>
                            </Style>
                        </TabControl.Resources>
                        <TabItem x:Uid="tab_program" Header="Program">
                            <cnccontrols:GCodeListControl/>
                        </TabItem>
                        <TabItem x:Uid="tab_3DView" x:Name="tab3D" Header="3D View">
                            <cncviewer:RenderControl x:Name="gcodeRenderer"/>
                        </TabItem>
                        <TabItem x:Uid="tab_console" x:Name="tabConsole" Header="Console">
                            <cnccontrols:ConsoleControl/>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Border>
            
            <!-- Right Panel - Work Parameters and Controls -->
            <StackPanel Grid.Column="2">
                <!-- Work Parameters Card -->
                <Border Style="{StaticResource HeroUI.Card}">
                    <StackPanel>
                        <TextBlock Text="Work Parameters" 
                                  FontSize="16" 
                                  FontWeight="SemiBold" 
                                  Foreground="{StaticResource HeroUI.Text.Primary}" 
                                  Margin="0,0,0,16"/>
                        <cnccontrols:WorkParametersControl x:Name="workParametersControl" 
                                                          HorizontalAlignment="Stretch" 
                                                          VerticalAlignment="Top" 
                                                          IsToolChanging="{Binding IsToolChanging}"/>
                    </StackPanel>
                </Border>
                
                <!-- Machine Controls Card -->
                <Border Style="{StaticResource HeroUI.Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Machine Controls" 
                                  FontSize="16" 
                                  FontWeight="SemiBold" 
                                  Foreground="{StaticResource HeroUI.Text.Primary}" 
                                  Margin="0,0,0,16"/>
                        <cnccontrols:CoolantControl HorizontalAlignment="Stretch" 
                                                   VerticalAlignment="Top" 
                                                   x:Name="coolantControl"/>
                        <cnccontrols:SpindleControl x:Name="spindleControl" 
                                                   HorizontalAlignment="Stretch" 
                                                   VerticalAlignment="Top"
                                                   Margin="0,12,0,0"/>
                        <cnccontrols:FeedControl x:Name="feedControl" 
                                                HorizontalAlignment="Stretch" 
                                                VerticalAlignment="Top"
                                                Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
        
        <!-- Bottom MDI Control -->
        <Border Grid.Row="1" 
               Background="{StaticResource HeroUI.Surface}" 
               BorderBrush="{StaticResource HeroUI.Border}"
               BorderThickness="0,1,0,0"
               Padding="16"
               MinHeight="60">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <cnccontrols:MDIControl x:Name="mdiControl" 
                                       HorizontalAlignment="Left" 
                                       VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Path=ParserState}" 
                          Visibility="{Binding Path=IsParserStateLive, Converter={StaticResource IsVisibleConverter}}" 
                          TextWrapping="NoWrap" 
                          Margin="16,0,0,0" 
                          HorizontalAlignment="Stretch" 
                          VerticalAlignment="Center" 
                          FontSize="14"
                          Foreground="{StaticResource HeroUI.Text.Secondary}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
