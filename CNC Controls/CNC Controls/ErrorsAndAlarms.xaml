<Window x:Class="CNC.Controls.ErrorsAndAlarms"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:CNC.Controls"
        mc:Ignorable="d"
        Title="Controller error and alarm codes" Height="500" Width="750" MinHeight="100" MinWidth="150" Icon="App.ico">
    <TabControl>
        <TabItem Header="Error codes">
            <local:GrblErrorList/>
        </TabItem>
        <TabItem Header="Alarm codes">
            <local:GrblAlarmList/>
        </TabItem>
    </TabControl>
</Window>
